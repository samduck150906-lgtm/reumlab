# Google Tag Manager (웹 컨테이너 ID: GTM-XXXX)
NEXT_PUBLIC_GTM_ID=

# 메타(페이스북) 픽셀 ID.
# 기본값(1021548000778850)이 코드(components/Analytics.tsx)에 들어 있어 비워둬도 동작합니다.
# 다른 픽셀로 바꿀 때만 여기에 ID를 넣으면 코드 기본값을 덮어씁니다.
# 주의: 픽셀을 GTM에도 넣으면 이중 집계되므로 둘 중 하나만 사용하세요.
NEXT_PUBLIC_META_PIXEL_ID=

# Search Console HTML 태그 검증용 (선택)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 상담폼 백엔드: Web3Forms 액세스 키 (https://web3forms.com 무료 발급, 월 250건)
# 비워두면 상담폼이 메일 앱(mailto)으로 안전하게 폴백합니다.
# 설정 시 입력 내용이 이메일로 전송되며, Web3Forms 대시보드에서 Slack/Webhook 알림 연동 가능.
NEXT_PUBLIC_WEB3FORMS_KEY=

# 카카오톡 채널 상담 링크 (선택). 예: https://pf.kakao.com/_xXXXXX/chat
# 설정 시 우하단 플로팅 버튼에 '카카오톡 상담'이 노출됩니다.
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
